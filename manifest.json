        {
          "src": "./img/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Last Played Playlist",
      "short_name": "Last Playlist",
      "description": "Play the last used playlist",
      "url": "./index.html?shortcut=last-playlist",
      "icons": [
        {
          "src": "./img/icon-192.png",
          "sizes": "192x192"
        }
      ]
